
use builtin;
use str;

set edit:completion:arg-completer[rstop] = {|@words|
    fn spaces {|n|
        builtin:repeat $n ' ' | str:join ''
    }
    fn cand {|text desc|
        edit:complex-candidate $text &display=$text' '(spaces (- 14 (wcswidth $text)))$desc
    }
    var command = 'rstop'
    for word $words[1..-1] {
        if (str:has-prefix $word '-') {
            break
        }
        set command = $command';'$word
    }
    var completions = [
        &'rstop'= {
            cand -i 'Sampling interval in milliseconds (250..=10000)'
            cand --interval 'Sampling interval in milliseconds (250..=10000)'
            cand --theme 'Color theme (also adjustable in F2 settings)'
            cand --view 'view'
            cand --gpu-panel 'Initial GPU display; device opens Device info (history aliases summary)'
            cand --config 'Alternate configuration file'
            cand --samples 'Number of samples; emits newline-delimited JSON, or fills SVG graph history'
            cand --export-svg 'Render real collected data to an SVG, without opening a terminal'
            cand --width 'width'
            cand --height 'height'
            cand --record 'record'
            cand --csv 'csv'
            cand --replay 'replay'
            cand --layout 'layout'
            cand --select-gpu 'Print CUDA_VISIBLE_DEVICES for N least busy devices meeting the free-memory limit'
            cand --min-free-mib 'min-free-mib'
            cand --min-total-mib 'Minimum total VRAM for GPU selection'
            cand --max-gpu-utilization 'GPU selection ceiling; devices with unknown utilization are excluded'
            cand --max-memory-utilization 'GPU selection memory-controller utilization ceiling'
            cand --no-gpu 'Disable GPU driver queries'
            cand --snapshot 'Print a JSON snapshot, then exit (includes process commands)'
            cand --write-config 'Write preferences to the configuration file, then exit'
            cand --ascii 'ascii'
            cand --no-color 'no-color'
            cand --threads 'threads'
            cand --process-network 'process-network'
            cand --read-only 'read-only'
            cand --full-sampling 'Preload all pages and keep their background sampling active'
            cand --no-config-exec 'Disable configured probes and alert commands'
            cand -h 'Print help'
            cand --help 'Print help'
            cand -V 'Print version'
            cand --version 'Print version'
            cand monitor 'Open the interactive system monitor (also the default command)'
            cand snapshot 'Print one JSON snapshot, including process command lines'
            cand sample 'Print newline-delimited JSON samples (ten by default)'
            cand record 'Record telemetry while monitoring; --samples selects headless recording'
            cand replay 'Replay a local recording; --samples selects JSON output'
            cand export 'Export live telemetry or a recording to CSV or SVG'
            cand gpu 'Open the GPU view or select CUDA devices'
            cand network 'Open connection monitoring, test a target, or capture packets'
            cand doctor 'Explain resource problems, recent trends and useful next steps'
            cand config 'Print the configuration path or write current preferences'
            cand completions 'Generate shell completions without reading configuration'
            cand man 'Print the manual page without reading configuration'
            cand update 'Update this installer-managed copy of rstop'
            cand help 'Print this message or the help of the given subcommand(s)'
        }
